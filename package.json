{
  "name": "zotero-ai-reading",
  "type": "module",
  "version": "3.1.8",
  "description": "Send selected Zotero literature to an n8n AI-reading workflow.",
  "config": {
    "addonName": "Zotero AI Reading",
    "addonID": "zotero-ai-reading@local",
    "addonRef": "zoteroaireading",
    "addonInstance": "ZoteroAIReading",
    "prefsPrefix": "extensions.zotero.zoteroaireading"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luelue-dot/Zotero-AI-Notes.git"
  },
  "author": "luelue-dot",
  "bugs": {
    "url": "https://github.com/luelue-dot/Zotero-AI-Notes/issues"
  },
  "homepage": "https://github.com/luelue-dot/Zotero-AI-Notes",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^10.7.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
